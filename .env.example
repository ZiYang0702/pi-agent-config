# Copy to .env, fill only needed providers, then: set -a; source .env; set +a
# Pi does not automatically load this file. Never commit real credentials.
# Codex subscription authentication: run /login in Pi instead.
# export OPENAI_API_KEY='YOUR_OPENAI_API_KEY'
# export ANTHROPIC_API_KEY='YOUR_ANTHROPIC_API_KEY'
# export DEEPSEEK_API_KEY='YOUR_DEEPSEEK_API_KEY'
# export VOLCENGINE_PLAN_API_KEY='YOUR_VOLCENGINE_PLAN_API_KEY'
# Optional network proxy (your own address):
# export HTTPS_PROXY='http://127.0.0.1:PORT'
# export HTTP_PROXY='http://127.0.0.1:PORT'
